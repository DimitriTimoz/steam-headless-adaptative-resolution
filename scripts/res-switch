#!/usr/bin/env bash
set -u

LOG="/home/default/log/res-switch.log"
mkdir -p "$(dirname "$LOG")"

{
  echo ""
  echo "---- $(date) ----"

  WIDTH="${SUNSHINE_CLIENT_WIDTH:-${1:-}}"
  HEIGHT="${SUNSHINE_CLIENT_HEIGHT:-${2:-}}"
  FPS="${SUNSHINE_CLIENT_FPS:-${3:-60}}"

  export DISPLAY="${DISPLAY:?DISPLAY not set}"

  if [ -z "$WIDTH" ] || [ -z "$HEIGHT" ]; then
    echo "Missing client resolution."
    exit 0
  fi

  case "$FPS" in
    60|59|120) ;;
    *) FPS=60 ;;
  esac

  TARGET="${WIDTH}x${HEIGHT}"
  echo "Requested resolution: ${TARGET}@${FPS}"

  XRANDR="$(xrandr -q 2>&1)"

  OUTPUT="$(echo "$XRANDR" | awk '/ primary/{print $1; exit}')"
  [ -z "$OUTPUT" ] && OUTPUT="$(echo "$XRANDR" | awk '/ connected/{print $1; exit}')"

  if [ -z "$OUTPUT" ]; then
    echo "No connected output found."
    exit 1
  fi

  echo "Using output: $OUTPUT"

  if echo "$XRANDR" | sed -n "/^$OUTPUT /,/^[^ ]/p" | grep -q "^[[:space:]]*$TARGET[[:space:]]"; then
    MODE="$TARGET"
    echo "Using existing mode: $MODE"
  else
    MODE="${TARGET}_${FPS}.00"
    echo "Creating custom mode: $MODE"

    MODELINE="$(cvt "$WIDTH" "$HEIGHT" "$FPS" | awk '/Modeline/ {$1=""; print substr($0,2)}')"
    MODELABEL="$(echo "$MODELINE" | awk -F '"' '{print $2}')"
    MODEARGS="$(echo "$MODELINE" | sed "s/\"$MODELABEL\"/\"$MODE\"/")"

    # shellcheck disable=SC2086
    xrandr --newmode $MODEARGS || true
    sleep 0.2
    xrandr --addmode "$OUTPUT" "$MODE" || true
  fi

  echo "Applying output mode only: $MODE"

  xrandr \
    --output "$OUTPUT" \
    --mode "$MODE" \
    --pos 0x0 \
    --rotate normal || true

  sleep 0.2

  echo "Final xrandr:"
  xrandr -q | head -n 20

  echo "Done."
} >> "$LOG" 2>&1
